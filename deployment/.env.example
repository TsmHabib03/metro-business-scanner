# Copy to deployment/.env.production. Never commit the populated file.
DOMAIN=scanner.example.com
# Generate two different hex secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_PASSWORD=replace_with_random_hex_database_secret
ACCESS_USERNAME=owner
ACCESS_PASSWORD=replace_with_a_different_random_hex_secret
# Optional reviewed raster tile provider; blank keeps a point-only map.
# These values become public browser configuration. Use restricted browser keys.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
