  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main discovery and save actions.",
      "html": "<button class=\"ds-primary ds-focus\">Start discovery scan</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 14px;border-radius:var(--radius,6px);font-family:'Inter Variable',Inter,sans-serif;font-size:12px;font-weight:550;min-height:39px;cursor:pointer;border:0;background:var(--teal,#0b665e);color:#fff}.ds-primary:hover{background:#084c46}.ds-primary:disabled{opacity:.55;cursor:not-allowed}@media(max-width:620px){.ds-primary{min-height:44px}}.ds-focus:focus-visible{outline:3px solid var(--focus,#27887f);outline-offset:3px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Supporting actions and website checks.",
      "html": "<button class=\"ds-secondary ds-focus\">Check website</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 14px;border-radius:var(--radius,6px);font-family:'Inter Variable',Inter,sans-serif;font-size:12px;font-weight:550;min-height:39px;cursor:pointer;border:1px solid #c6d3d5;background:#fff;color:var(--ink,#243840)}.ds-secondary:hover{background:#f1f6f5}.ds-secondary:disabled{opacity:.55;cursor:not-allowed}@media(max-width:620px){.ds-secondary{min-height:44px}}.ds-focus:focus-visible{outline:3px solid var(--focus,#27887f);outline-offset:3px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "field",
      "description": "A visible label and a compact editable value.",
      "html": "<label class=\"ds-label\">Business category<input class=\"ds-field ds-focus\" value=\"Dental clinics\"></label>",
      "css": ".ds-label{display:block;font-family:'Inter Variable',Inter,sans-serif;font-size:12px;font-weight:550;color:var(--ink,#243840)}.ds-field{display:block;margin-top:7px;width:100%;padding:10px 11px;min-height:39px;border:1px solid #bfced1;border-radius:var(--radius,6px);background:#fff;color:var(--ink,#243840);font-family:'Inter Variable',Inter,sans-serif;font-size:13px;font-weight:400;caret-color:var(--teal,#0b665e)}.ds-focus:focus-visible{outline:3px solid var(--focus,#27887f);outline-offset:3px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Slate navigation with an explicit current destination.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Scanner\"><button class=\"ds-nav-item ds-current ds-focus\" aria-current=\"page\">Discover</button><button class=\"ds-nav-item ds-focus\">Prospects</button></nav>",
      "css": ".ds-nav{padding:15px;background:var(--nav,#18343e);display:flex;flex-direction:column;gap:6px}.ds-nav-item{border:0;display:block;text-align:left;padding:12px 14px;border-radius:6px;color:#bfd0d5;font-family:'Inter Variable',Inter,sans-serif;font-size:13px;font-weight:500;background:transparent;cursor:pointer}.ds-nav-item:hover{background:#244650;color:#fff}.ds-nav-item.ds-current{background:#2b535b;color:#fff}.ds-focus:focus-visible{outline:3px solid var(--focus,#27887f);outline-offset:3px}"
    },
    {
      "name": "Website Status",
      "kind": "chip",
      "refersTo": "badge-not-listed",
      "description": "Written website uncertainty supported by amber color.",
      "html": "<span class=\"ds-badge\"><span aria-hidden=\"true\"></span>No website listed</span>",
      "css": ".ds-badge{display:inline-flex;gap:5px;align-items:center;border-radius:4px;padding:4px 6px;font-family:'Inter Variable',Inter,sans-serif;font-size:9px;line-height:1.3;font-weight:500;background:#fbf0dc;color:#78531d}.ds-badge>span{width:4px;height:4px;border-radius:50%;background:currentColor}@media(max-width:620px){.ds-badge{font-size:10px}}"
    },
    {
      "name": "Working Container",
      "kind": "card",
      "refersTo": "container",
      "description": "White working surface separated by a fine outline.",
      "html": "<section class=\"ds-panel\"><h2>Scan history</h2><p>Review completed scans and source observations.</p></section>",
      "css": ".ds-panel{background:#fff;border:1px solid var(--line,#dce4e5);border-radius:8px;padding:27px;color:var(--ink,#243840);font-family:'Inter Variable',Inter,sans-serif;min-height:180px}.ds-panel h2{margin:0;font-size:20px;font-weight:650;letter-spacing:-.02em}.ds-panel p{margin:10px 0 0;color:var(--muted,#5c7078);font-size:12px;line-height:1.7;max-width:740px}@media(max-width:620px){.ds-panel{padding:22px 18px}.ds-panel h2{font-size:18px}.ds-panel p{font-size:11px}}"
    },
    {
      "name": "Selected Record",
      "kind": "custom",
      "refersTo": "selected-record",
      "description": "A business record linked to its evidence.",
      "html": "<button class=\"ds-record ds-focus\"><strong>Caindec Dental Clinic</strong><span>Dental clinic · Makati</span></button>",
      "css": ".ds-record{display:block;text-align:left;width:100%;border:0;border-top:1px solid var(--line,#dce4e5);padding:16px;background:var(--selected,#e5f2ef);color:var(--ink,#243840);font-family:'Inter Variable',Inter,sans-serif;cursor:pointer}.ds-record:hover{background:#f4f9f7}.ds-record strong{display:block;font-size:13px;font-weight:600;line-height:1.5;overflow-wrap:anywhere}.ds-record>span{display:block;color:var(--muted,#5c7078);font-size:10px;line-height:1.6;margin-top:3px}@media(max-width:620px){.ds-record{padding:16px 14px}.ds-record strong{font-size:13px}}.ds-focus:focus-visible{outline:3px solid var(--focus,#27887f);outline-offset:3px}"
    },
    {
      "name": "Source Social Link",
      "kind": "custom",
      "description": "A platform link with source-listed provenance.",
      "html": "<a class=\"ds-social\" href=\"https://www.instagram.com/\"><strong>Instagram</strong><small>Source-listed contact:instagram</small></a>",
