      "Explicit source, uncertainty and website status text.",
      "Responsive controls and a scrollable evidence panel."
    ],
    "rules": [
      {
        "name": "The Written Status Rule",
        "body": "Preserve a visible status label alongside every status color.",
        "section": "colors"
